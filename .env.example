# ===== Copie ce fichier en .env puis adapte les valeurs =====
# cp .env.example .env

# --- PostgreSQL (Docker) ---
POSTGRES_DB=crousty
POSTGRES_USER=crousty
# Génère un mot de passe fort, ex. : openssl rand -base64 24
POSTGRES_PASSWORD=change-moi-avec-un-mot-de-passe-fort

# --- Port public de l'application (Nginx) ---
HTTP_PORT=8080

# --- API ---
# Laisser vide en production derrière Nginx (même origine).
CORS_ORIGIN=
# Nombre de proxys de confiance devant l'API (Nginx = 1, + 1 si un proxy HTTPS est devant Nginx)
TRUST_PROXY=1
RATE_LIMIT_MAX=600
RATE_LIMIT_CREATE_MAX=30
# Durée de réservation d'un code à 4 chiffres (heures)
SESSION_TTL_HOURS=48
# Durée d'affichage (en gris) d'une session clôturée sur l'accueil (heures)
LOBBY_CLOSED_HOURS=1
# Numéro de téléphone affiché dans les sessions Crousty
CROUSTY_PHONE=0554796424
